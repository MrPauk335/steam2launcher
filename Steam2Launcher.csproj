<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <Target Name="CopyPostTxt" AfterTargets="Build">
    <Copy SourceFiles="..\post.txt" DestinationFolder="$(OutputPath)"
          Condition="Exists('..\post.txt')" SkipUnchangedFiles="true"/>
  </Target>

</Project>
