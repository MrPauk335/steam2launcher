<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeName">Light</sys:String>
    <SolidColorBrush x:Key="BgBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SubFgBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E5B"/>
</ResourceDictionary>