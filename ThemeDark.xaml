<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="ThemeName">Dark</sys:String>
    <SolidColorBrush x:Key="BgBrush" Color="#0E1013"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#17191E"/>
    <SolidColorBrush x:Key="FgBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="SubFgBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2E37"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#57C78D"/>
    <SolidColorBrush x:Key="PlayBrush" Color="#5DA130"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C2403C"/>
    <LinearGradientBrush x:Key="TileBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#1E3A8A" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>